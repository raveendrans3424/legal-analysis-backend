# Copy this file to ".env" and fill in your real values. NEVER commit the real .env file.

# ---- Database (MySQL) ----
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_mysql_password_here
DB_NAME=legal_analysis_db

# ---- Security ----
JWT_SECRET=generate_a_random_64_char_string_here
FILE_ENCRYPTION_KEY=generate_a_random_64_char_hex_here

# ---- AI / LLM API Keys ----
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
INDIAN_KANOON_API_KEY=your_indian_kanoon_api_key_here
LLM_PROVIDERS=groq,gemini

# ---- AWS S3 (file uploads) ----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-south-1

# ---- CORS (comma-separated list of allowed frontend origins) ----
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Optional: Tesseract path (Windows only) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Optional: Local LLM via Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
